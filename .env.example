# Application — generate APP_KEY with php artisan key:generate
APP_NAME=ForecastApp
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Sessions
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=forecastapp-session
SESSION_PATH=/
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache, files and queues
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# PostgreSQL — set your own DB_PASSWORD before starting Docker
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=forecastapp
DB_USERNAME=forecastapp
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=prefer

# Forecast location — Chalastra, Thessaloniki
FORECAST_LAT=40.626430
FORECAST_LON=22.732910
FORECAST_LOCATION_TIMEZONE=Europe/Athens

# Daily collection schedule — local time in the zone below
FORECAST_COLLECTION_TIME=06:00
FORECAST_SCHEDULE_TIMEZONE=Europe/Athens

# WeatherAPI — paste your dashboard API key into your local .env only
WEATHERAPI_KEY=
